{
  "rewrites": [
    {
      "source": "/app/terrapos/webhooks/gofood/:path*",
      "destination": "https://api.ansilum.com/app/terrapos/webhooks/gofood/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.ansilum.com/app/terrapos/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
